# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (matches docker-compose.yml in the repo root)
DATABASE_URL=postgres://meetly:meetly@localhost:5432/meetly

# Login cookie signing key: use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# From Google Cloud Console (OAuth client ID, type: Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Allowed university email domains
STUDENT_DOMAIN=g.bracu.ac.bd
FACULTY_DOMAIN=bracu.ac.bd
